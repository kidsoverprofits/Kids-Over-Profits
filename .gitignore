# Environment files
.env

# Never track Git metadata directories/files from nested repos
.git
**/.git
**/.git/
**/.git/**
**/.gitmodules

# System files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# WordPress core files (this is a child theme - exclude WP core)
wp-content/
wp-includes/
wp-admin/
wp-*.php
xmlrpc.php
license.txt
readme.html

# WordPress configuration
wp-config.php
wp-config-local.php

# KOP API configuration
api/config.local.php
api/ai-config.php
.claude/
settings.json

# SQL reference files (not for deployment)
facilities_master.sql
wiki_master.sql
submissions_database.sql
update_organizations.sql

# Claude Code temp files
tmpclaude-*

# MN scraper — local state (browser profile, progress cache, temp)
.tmp/
scripts/.mn-browser-profile/
scripts/mn_progress.json

# Article discovery — runtime state written by the nightly cron on the server
# (seen-URL cache + rejected log). Never tracked: a committed copy would be
# overwritten by every deploy (.cpanel.yml copies scripts/ wholesale).
scripts/.discovery-state.json
scripts/.discovery-rejected.json

# PHP-generated error logs (PHP drops these wherever it runs from; if one
# lands in the cPanel-side checkout it blocks deploy with a dirty working
# tree). Also catch __pycache__ which keeps slipping into commits.
error_log
**/error_log
__pycache__/
**/__pycache__/

# Local SQLite copy of prod (scripts/sync-prod-sqlite.py)
*.sqlite
*.sqlite.building
*.sqlite-journal

# History page dumps used by scripts/history/normalize.py
scripts/history/raw/
scripts/history/*.outline.txt

# Script and harness output: data-model page baselines, the prod SQLite dump,
# network map QA and screenshots, reporting directory checks, inspection
# highlight dry runs (these quote unreviewed findings by facility name, so they
# must never reach this public repo). The two files committed here before this
# rule stay tracked.
/tmp/
