# Environment files
.env

# Never track Git metadata directories/files from nested repos
.git
**/.git
**/.git/
**/.git/**
**/.gitmodules

# System files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# WordPress core files (this is a child theme - exclude WP core)
wp-content/
wp-includes/
wp-admin/
wp-*.php
xmlrpc.php
license.txt
readme.html

# WordPress configuration
wp-config.php
wp-config-local.php

# KOP API configuration
api/config.local.php
api/ai-config.php
.claude/
settings.json

# SQL reference files (not for deployment)
facilities_master.sql
wiki_master.sql
submissions_database.sql
update_organizations.sql

# Claude Code temp files
tmpclaude-*

# MN scraper — local state (browser profile, progress cache, temp)
.tmp/
scripts/.mn-browser-profile/
scripts/mn_progress.json

# Article discovery — local seen-URL cache (persisted via GH Actions cache in CI)
scripts/.discovery-state.json
scripts/.discovery-rejected.log
