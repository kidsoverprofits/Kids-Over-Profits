# Environment files
.env

# Never track Git metadata directories/files from nested repos
.git
**/.git
**/.git/
**/.git/**
**/.gitmodules

# System files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# WordPress core files (this is a child theme - exclude WP core)
wp-content/
wp-includes/
wp-admin/
wp-*.php
xmlrpc.php
license.txt
readme.html

# WordPress configuration
wp-config.php
wp-config-local.php

# KOP API configuration
api/config.local.php
api/ai-config.php
.claude/
settings.json

# SQL reference files (not for deployment)
facilities_master.sql
wiki_master.sql
submissions_database.sql
update_organizations.sql

# Claude Code temp files
tmpclaude-*

# MN scraper — local state (browser profile, progress cache, temp)
.tmp/
scripts/.mn-browser-profile/
scripts/mn_progress.json

# Article discovery — runtime state written by the nightly cron on the server
# (seen-URL cache + rejected log). Never tracked: a committed copy would be
# overwritten by every deploy (.cpanel.yml copies scripts/ wholesale).
scripts/.discovery-state.json
scripts/.discovery-rejected.json

# PHP-generated error logs (PHP drops these wherever it runs from; if one
# lands in the cPanel-side checkout it blocks deploy with a dirty working
# tree). Also catch __pycache__ which keeps slipping into commits.
error_log
**/error_log
__pycache__/
**/__pycache__/

# Facility data model migration (docs/DATA-MODEL-MIGRATION.md) - page baselines
# and rehearsal output are regenerated from production data; never commit them.
tmp/baseline-*.json
tmp/after-*.json
tmp/rehearsal/
# Per-state legacy-vs-v2 page snapshots from the same harness; add other
# state names here as they are captured.
tmp/*-v2.json
tmp/utah.json

# Local SQLite copy of prod (scripts/sync-prod-sqlite.py)
tmp/*.sql
tmp/*.sql.part
*.sqlite
*.sqlite.building
*.sqlite-journal

# Network map QA report (scripts/build-network-graph.js); regenerated on every
# build from the committed CSVs, so it is review output, not source.
tmp/network-qa.md
# Generated by scripts/check-staging-links.py
tmp/staging-links.md
# Dry-run report from scripts/test-inspection-highlights.php --report; quotes
# unreviewed findings by facility name, so it never goes to the public repo.
tmp/highlights-*.md
# Screenshots from scripts/preview-network-map.py --shots tmp/map-preview
tmp/map-preview/

# Inspection highlights dry runs (scripts/test-inspection-highlights.php
# --report): unreviewed excerpts that name facilities, never to be committed.
tmp/inspection-highlights-*.md

# History page dumps used by scripts/history/normalize.py
scripts/history/raw/
scripts/history/*.outline.txt
# Reporting directory build and link-check output (scripts/build-reporting-directory.js,
# scripts/verify-reporting-links.js, scripts/test-reporting-directory.php). All three are
# regenerated from the committed JSON, so they are review output, not source.
tmp/reporting-qa.md
tmp/reporting-links.md
tmp/reporting-links.json
tmp/report-abuse.html
