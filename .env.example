# Database Configuration
# Copy this file to .env and fill in your actual credentials
#
# Note: If your password contains special characters (&, !, #, @, etc.),
# wrap it in quotes: DB_PASS="my!pass@word#123"

DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS="your_database_password"
DB_CHARSET=utf8mb4

# API Keys for External Services
CLOUDMERSIVE_API_KEY=your_cloudmersive_api_key_here

# Data API key — protects api/get-all-data.php from unauthenticated access
# Use any long random string. Required in URL as ?key=... or X-Api-Key header.
KOP_DATA_API_KEY=your_data_api_key_here

# Inspections API — protects api/inspections-write.php
# Set this to any long random string; configure the same value on the server.
INSPECTIONS_API_BASE=https://kidsoverprofits.org/wp-content/themes/child
INSPECTIONS_API_KEY=your_inspections_api_key_here

# FileBird Pro API Key - Get from: https://ninjateam.gitbook.io/filebird/integrations/developer-zone/apis
FILEBIRD_API_KEY=your_filebird_api_key_here

# AI Provider API Keys (for News Processor)
# Groq (Free Tier - Very Fast) - Get key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Alternative spelling also supported:
# GROK_API_KEY=your_groq_api_key_here

# Google Gemini (Free Tier) - Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face (Free Tier) - Get key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Anthropic Claude (Paid API) - Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CourtListener (Free, federal docket lookups for lawsuits page) - Get a token at:
# https://www.courtlistener.com/help/api/rest/  (free signup, no card)
COURTLISTENER_API_KEY=your_courtlistener_api_key_here

# Note: Ollama does not require an API key - it runs locally
# Install Ollama from: https://ollama.com/download
# Then run: ollama pull llama3.2
